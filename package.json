{
  "name": "innovazione-webcomp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "rm -rf dist && npx @tailwindcss/cli -i ./src/index.css -o ./src/output.css && cp ./vfs_fonts.js ./node_modules/pdfmake/build/vfs_fonts.js && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*' && cp ./dist/index*.js ./dist/innovazione-webcomp.js && cp ./dist/index*.css ./dist/innovazione-webcomp.css",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@tailwindcss/cli": "^4.3.1",
    "@types/pdfmake": "^0.3.3",
    "blob-stream": "^0.1.3",
    "clsx": "^2.1.1",
    "html-entities": "^2.6.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "pdfmake": "^0.3.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-schemaorg": "^2.0.1",
    "react-to-webcomponent": "^2.0.1",
    "schema-dts": "^2.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/blob-stream": "^0.1.33",
    "@types/bun": "1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.1"
  },
  "module": "src/index.ts",
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
