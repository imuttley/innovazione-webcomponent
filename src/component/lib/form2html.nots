import type { SchedaData, AppTranslations } from './type';
import { capitalizeWords, nameFamilynameDipt } from './utils';
import { trlv2 } from './trlv2const';

/**
 * Converte i dati della scheda in una stringa HTML semantica e validata.
 * Ottimizzata per la stampa PDF/UA con Puppeteer o Playwright.
 */
export function form2html(
    formdata: SchedaData, 
    lang: "en" | "it", 
    dict: AppTranslations, 
    fromurl: string
): string {

    // Helper per escape HTML base (per evitare problemi con caratteri speciali)
    const escapeHTML = (str: string) => {
        return str
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    };

    // Costruisce la sezione TRL
    let trlHtml = '';
    const trlKeys = Object.keys(trlv2[lang]).filter(k => k.startsWith('TRL'));
    const trlValue = formdata.trl ? parseInt(formdata.trl, 10) : 0;

    if (trlValue > 0) {
        let trlRows = '';
        trlKeys.forEach((key, index) => {
            const level = index + 1;
            const isActive = level <= trlValue;
            const rowClass = isActive ? 'trl-active' : 'trl-inactive';
            const checkMark = isActive ? '✓' : '';
            
            trlRows += `
                <tr class="${rowClass}">
                    <td class="trl-level">TRL ${level}</td>
                    <td class="trl-desc">${escapeHTML(trlv2[lang][key as keyof typeof trlv2["en"]])}</td>
                    <td class="trl-check">${checkMark}</td>
                </tr>
            `;
        });

        trlHtml = `
            <section class="section">
                <h2>${escapeHTML(dict['Stato di sviluppo TRL'] || 'TRL')}</h2>
                <table class="trl-table" aria-label="Tabella Livelli TRL">
                    <thead>
                        <tr>
                            <th scope="col">Livello</th>
                            <th scope="col">Descrizione</th>
                            <th scope="col">Stato</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${trlRows}
                    </tbody>
                </table>
            </section>
        `;
    }

    // Costruisce la sezione Galleria Immagini
    let galleryHtml = '';
    if (formdata.image_grid && formdata.image_grid.length > 0) {
        const figures = formdata.image_grid.map(img => {
            const desc = img.description || '';
            return `
                <figure class="gallery-item">
                    <img src="${img.image_base64}" alt="${escapeHTML(desc)}" />
                    ${desc ? `<figcaption>${escapeHTML(desc)}</figcaption>` : ''}
                </figure>
            `;
        }).join('');

        galleryHtml = `
            <section class="section gallery-section">
                <h2>${escapeHTML(dict['Galleria Immagini'] || 'Galleria Immagini')}</h2>
                <div class="gallery-grid">
                    ${figures}
                </div>
            </section>
        `;
    }

    // Costruisce i contatti
    let contactsHtml = '';
    if (formdata.contact_name && formdata.contact_name.length > 0) {
        const contactsList = formdata.contact_name.map((contact, index) => {
            const name = nameFamilynameDipt(contact);
            const email = formdata.contact_email?.[index] || '';
            const phone = formdata.contact_phone?.[index] || '';
            return `
                <li class="contact-card">
                    <strong>${escapeHTML(name)}</strong><br>
                    ${email ? `Email: <a href="mailto:${escapeHTML(email)}">${escapeHTML(email)}</a><br>` : ''}
                    ${phone ? `Tel: ${escapeHTML(phone)}` : ''}
                </li>
            `;
        }).join('');

        contactsHtml = `
            <section class="section avoid-break">
                <h2>${escapeHTML(dict['Contatti'] || 'Contatti')}</h2>
                <ul class="contacts-list">
                    ${contactsList}
                </ul>
            </section>
        `;
    }

    // Ritorna il documento HTML completo
    return `<!DOCTYPE html>
<html lang="${lang}">
<head>
    <meta charset="UTF-8">
    <title>${escapeHTML(formdata.name || 'Scheda ENEA')}</title>
    <style>
        /* Reset e Base */
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            line-height: 1.5;
            color: #333;
            margin: 0;
            padding: 2cm;
            background-color: #fff;
        }

        /* Tipografia */
        h1 {
            color: #0056b3;
            font-size: 24pt;
            border-bottom: 2px solid #0056b3;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        h2 {
            color: #0056b3;
            font-size: 18pt;
            margin-top: 30px;
            margin-bottom: 15px;
            border-bottom: 1px solid #ccc;
            padding-bottom: 5px;
        }
        p {
            margin-bottom: 10px;
            font-size: 12pt;
        }
        .meta-info {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        /* Tabelle (TRL) */
        .trl-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        .trl-table th, .trl-table td {
            border: 1px solid #ddd;
            padding: 8px 12px;
            text-align: left;
        }
        .trl-table th {
            background-color: #f1f1f1;
            font-weight: bold;
        }
        .trl-active {
            background-color: #e6f3ff;
            color: #004085;
        }
        .trl-inactive {
            color: #6c757d;
        }
        .trl-check {
            text-align: center;
            font-weight: bold;
            color: #28a745;
        }

        /* Galleria Immagini */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
        .gallery-item {
            margin: 0;
            break-inside: avoid;
        }
        .gallery-item img {
            max-width: 100%;
            height: auto;
            border: 1px solid #eee;
            border-radius: 4px;
        }
        figcaption {
            font-size: 10pt;
            color: #555;
            text-align: center;
            margin-top: 5px;
            font-style: italic;
        }

        /* Contatti */
        .contacts-list {
            list-style: none;
            padding: 0;
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }
        .contact-card {
            border: 1px solid #ddd;
            padding: 15px;
            border-radius: 5px;
            background: #fafafa;
            flex: 1 1 200px;
            break-inside: avoid;
        }

        /* Regole specifiche per la stampa in PDF */
        @media print {
            body {
                padding: 0;
            }
            @page {
                margin: 2cm;
                size: A4 portrait;
            }
            .avoid-break {
                break-inside: avoid;
            }
            .section {
                break-inside: auto;
            }
            h2, h3 {
                break-after: avoid;
            }
            a {
                text-decoration: none;
                color: #0056b3;
            }
        }
    </style>
</head>
<body>
    <main>
        <header>
            <h1>${escapeHTML(formdata.name || 'Scheda ENEA')}</h1>
            <div class="meta-info">
                <p><strong>${escapeHTML(dict['Titolo breve'] || 'Titolo breve')} / ${escapeHTML(dict['Titolo esteso'] || 'Titolo esteso')}:</strong> ${escapeHTML(formdata.name || '')}</p>
                <p><strong>${escapeHTML(dict['Keywords'] || 'Keywords')}:</strong> ${escapeHTML(formdata.keyword || '')}</p>
                ${fromurl ? `<p><strong>Link:</strong> <a href="${fromurl}">${fromurl}</a></p>` : ''}
            </div>
        </header>

        ${formdata.description ? `
        <section class="section">
            <h2>${escapeHTML(dict['Descrizione'] || 'Descrizione')}</h2>
            <p>${escapeHTML(formdata.description)}</p>
        </section>
        ` : ''}

        ${trlHtml}

        ${formdata.advantage ? `
        <section class="section avoid-break">
            <h2>${escapeHTML(dict['Vantaggi'] || 'Vantaggi')}</h2>
            <p>${escapeHTML(formdata.advantage)}</p>
        </section>
        ` : ''}

        ${formdata.application ? `
        <section class="section avoid-break">
            <h2>${escapeHTML(dict['Applicazioni'] || 'Applicazioni')}</h2>
            <p>${escapeHTML(formdata.application)}</p>
        </section>
        ` : ''}

        ${formdata.innovative ? `
        <section class="section avoid-break">
            <h2>${escapeHTML(dict['Aspetti innovativi'] || 'Aspetti innovativi')}</h2>
            <p>${escapeHTML(formdata.innovative)}</p>
        </section>
        ` : ''}

        ${formdata.patent ? `
        <section class="section avoid-break">
            <h2>${escapeHTML(dict['Brevetti'] || 'Brevetti')}</h2>
            <p><strong>Dettagli:</strong> ${escapeHTML(formdata.patent)}</p>
            ${formdata.author_patent ? `<p><strong>Autori:</strong> ${escapeHTML(formdata.author_patent)}</p>` : ''}
        </section>
        ` : ''}

        ${galleryHtml}
        
        ${contactsHtml}

    </main>
</body>
</html>`;
}
